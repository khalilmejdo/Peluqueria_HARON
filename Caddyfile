# =====================================================================
#  Peluquería HARON — entrée HTTPS
#
#  Caddy demande et renouvelle le certificat Let's Encrypt tout seul. Il n'y
#  a rien à faire de plus que : le nom de domaine pointe sur la machine, et
#  les ports 80 et 443 sont ouverts DANS LES DEUX pare-feux d'OCI (la liste
#  de sécurité du réseau ET iptables sur la machine).
#
#  DOMAINES et COURRIEL_TLS viennent de l'environnement (docker-compose.oci.yml).
#
#  PLUSIEURS NOMS POUR LE MÊME SALON. `DOMAINES` accepte une liste séparée par
#  des virgules, et Caddy demande un certificat pour chacun. C'est ce qui permet
#  de changer d'adresse SANS RIEN CASSER : le nouveau nom sert, l'ancien continue
#  de répondre, et le QR Code déjà collé en vitrine reste valable le temps qu'on
#  le remplace. Le cas n'est pas théorique — certains opérateurs mobiles filtrent
#  les domaines dynamiques, et il faut alors pouvoir en changer sans laisser un
#  client devant une adresse morte.
#
#  L'adresse CANONIQUE reste `DOMAINE` : c'est elle qu'encode le QR Code et
#  qu'utilisent les liens de suivi. Les autres ne font que répondre aussi.
#
#  POURQUOI SI COURT. Le suivi d'un client et l'écran du coiffeur tiennent une
#  connexion ouverte pendant des heures (Server-Sent Events). Avec nginx il
#  faudrait couper la mise en tampon et rallonger les délais à la main ;
#  Caddy reconnaît « text/event-stream » et écrit au fil de l'eau de lui-même,
#  et son transport HTTP n'impose aucun délai de lecture par défaut. Le flux
#  passe donc sans un mot de configuration — et c'est une configuration qu'on
#  ne peut pas se tromper en écrivant.
# =====================================================================

{
	email {$COURRIEL_TLS}
	log {
		output stdout
		format json
	}

	# PAS DE HTTP/3, ET C EST DELIBERE.
	#
	# HTTP/3 passe par UDP sur le port 443. Beaucoup de reseaux mobiles le
	# bloquent ou le degradent -- sans le REFUSER : la connexion reste
	# suspendue. Or Caddy annonce « Alt-Svc: h3 » avec une duree de vie de
	# trente jours : un navigateur qui a vu le site UNE FOIS en wifi essaiera
	# QUIC en premier sur tous les autres reseaux pendant un mois.
	#
	# Resultat observe le 24 septembre : le salon s ouvrait en wifi et
	# tournait indefiniment en 5G. Le sablier, pas une erreur -- donc rien
	# dans les journaux, et une heure perdue a soupconner le DNS.
	#
	# Le gain de HTTP/3 se compte en dizaines de millisecondes sur une page
	# deja legere. Le cout, c est un client debout devant la vitrine qui
	# regarde une page blanche. Le choix est vite fait.
	servers {
		protocols h1 h2
	}
}

{$DOMAINES} {
	encode zstd gzip

	# « haron-app », jamais « app ». Sur une machine qui heberge une seconde
	# application, « app » designe souvent DEUX conteneurs : Docker en choisit
	# alors un au hasard, et le salon sert les pages de l autre site une fois
	# sur deux. L alias est declare dans docker-compose.oci.yml et il est
	# unique ; sur une installation qui n heberge que le salon, rien ne change.
	#
	# keepalive 30s : Caddy doit lacher une connexion inactive AVANT que Node
	# ne la ferme (keepAliveTimeout 65 s). Avec ses deux minutes par defaut, un
	# POST pouvait partir sur une connexion deja fermee par Node -- et Caddy,
	# qui rejoue un GET, ne rejoue pas un POST : 502 isole sur « client servi ».
	reverse_proxy haron-app:3000 {
		transport http {
			keepalive 30s
		}
	}

	# L'application pose déjà ses propres en-têtes de sécurité (CSP stricte,
	# nosniff, frame-ancestors, Referrer-Policy). On n'ajoute ici que ce que
	# seul le point d'entrée HTTPS peut légitimement affirmer.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# =====================================================================
#  CE QUI N'EST PROPRE QU'A CETTE MACHINE
#
#  Tout fichier `.caddy` depose dans `caddy.d/` est lu ici. C'est la que
#  vivent les autres sites heberges sur le meme serveur — une seconde
#  application, une redirection, un sous-domaine d'essai.
#
#  POURQUOI PAS DIRECTEMENT DANS CE FICHIER. Parce qu'il est suivi par git.
#  Une ligne ajoutee a la main ici rend le dossier « sale », et
#  `deployer.sh` refuse alors de partir : la mise a jour du salon se
#  retrouve bloquee par la configuration d'une application qui n'a rien a
#  voir. C'est exactement ce qui est arrive le 25 septembre.
#
#  `caddy.d/` est ignore par git : ce qu'on y met reste sur la machine, et
#  ne part jamais dans un depot public.
#
#  Le motif n'a pas besoin de correspondre a quelque chose : un dossier
#  vide est le cas normal d'une installation qui n'heberge que le salon.
# =====================================================================
import /etc/caddy/conf.d/*.caddy
