# =====================================================================
#  Peluqueria HARON - variables d'environnement
#
#  Copier ce fichier en .env, puis generer les trois secrets :
#      npm run keygen
#
#  Aucun secret ne doit etre ecrit dans le code ni commite.
# =====================================================================

# --- Execution --------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Fuseau du salon. Toute notion de « jour », « aujourd'hui », « horaire »
# se lit dans ce fuseau, jamais dans celui du serveur.
#   Espagne : Europe/Madrid    Maroc : Africa/Casablanca
# Valeur de DEPART : le fuseau se change ensuite a l ecran (Marque > Pays).
APP_TIMEZONE=Europe/Madrid

# --- Langue et monnaie : SEULEMENT A LA PREMIERE INSTALLATION ---------
#
# Ces deux variables ne sont lues que par le seed, sur une base ou le reglage
# n'existe pas encore. Elles decident de la langue dans laquelle le salon
# s'installe : l'accroche de la page d'accueil, le nom du premier fauteuil, les
# quinze prestations de depart et le nom du compte gerant.
#
# ENSUITE, C'EST L'ECRAN QUI COMMANDE. La langue et la monnaie se changent dans
# « Reglages > Identite du salon », et ce qui est en base fait foi : modifier ce
# fichier apres coup ne change plus rien, et c'est voulu.
#
#   Espagne : APP_LANGUE=es  APP_MONNAIE=EUR
#   Maroc   : APP_LANGUE=fr  APP_MONNAIE=MAD
#
# La monnaie ne convertit aucun montant : elle change le symbole, et les prix de
# depart sont ceux du pays (une coupe a 7 EUR ou a 40 MAD, pas la conversion de
# l'un en l'autre).
APP_LANGUE=es
APP_MONNAIE=EUR
#
# L'ACTIVITE du salon, meme regle (installation neuve seulement) : elle choisit
# la carte de depart (prestations, chapitres, durees) et le style propose
# (palette, lettres). Tout se change ensuite dans l'onglet « Marque ».
#   BARBERIA    barbier, homme
#   PELUQUERIA  salon de coiffure, femme
#   UNISEX      salon mixte
#   ESTETICA    institut de beaute
#   ONGLES      bar a ongles
APP_ACTIVITE=BARBERIA

# --- Base de donnees --------------------------------------------------
DATABASE_URL=postgresql://haron:motdepasse@127.0.0.1:5432/haron
# off | require | verify   (off est acceptable sur un reseau Docker interne)
DATABASE_SSL=off
# DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# --- Secrets (64 caracteres hexadecimaux chacun, tous differents) ------
# Generer avec : npm run keygen
APP_SECRET=
APP_ENCRYPTION_KEY=
APP_PASSWORD_PEPPER=
# Renseignee uniquement pendant une rotation de cle de chiffrement.
# APP_ENCRYPTION_KEY_PREVIOUS=

# --- Nom de domaine (deploiement sur une machine nue) -----------------
# Utilises par docker-compose.oci.yml et le Caddyfile. Ils suffisent :
# PUBLIC_URL et ALLOWED_ORIGINS en sont deduits.
# Voir docs/DEPLOIEMENT-OCI.md.
DOMAINE=file.peluqueria-haron.com
COURRIEL_TLS=vous@exemple.com

# --- Securite HTTP ----------------------------------------------------
# Adresse publique de l'application, sans barre finale. Elle sert au
# controle d'origine ET au QR Code imprime dans le salon.
#
# A renseigner uniquement en developpement ou derriere un proxy deja en
# place : sur une machine nue, docker-compose.oci.yml les calcule depuis
# DOMAINE.
PUBLIC_URL=https://file.peluqueria-haron.com
ALLOWED_ORIGINS=https://file.peluqueria-haron.com
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
SECURE_COOKIES=true
ENABLE_HSTS=true

# --- Premier compte du personnel --------------------------------------
# Cree au premier demarrage si aucun compte n'existe. Retirer le mot de
# passe de l'environnement une fois la premiere connexion faite.
BOOTSTRAP_ADMIN_USERNAME=haron
BOOTSTRAP_ADMIN_PASSWORD=

# --- WhatsApp Business (API Cloud de Meta) ----------------------------
# Facultatif. Sans ces variables, l'application fonctionne entierement :
# le client recoit son lien a l'ecran, et le coiffeur dispose d'un lien
# « wa.me » d'un seul geste. Avec elles, les trois messages partent seuls.
#
# WHATSAPP_NUMERO_ID : identifiant du numero d'envoi chez Meta
# WHATSAPP_JETON     : jeton d'acces permanent
# Les MODELES doivent etre approuves par Meta avant tout envoi.
WHATSAPP_ACTIF=false
WHATSAPP_NUMERO_ID=
WHATSAPP_JETON=
WHATSAPP_LANGUE=fr
WHATSAPP_MODELE_CONFIRMATION=haron_tour_enregistre
WHATSAPP_MODELE_APPROCHE=haron_tour_approche
WHATSAPP_MODELE_TOUR=haron_c_est_votre_tour
# Indicatif par defaut applique a un numero saisi sans « + » (34 = Espagne,
# 212 = Maroc, 33 = France).
TELEPHONE_INDICATIF_DEFAUT=34

# --- Remontee des erreurs (Sentry) ------------------------------------
# Facultatif. Sans SENTRY_DSN, rien n est envoye nulle part : pas de
# requete, pas de minuterie, aucun cout.
#
# SEULES les erreurs NON GEREES partent (celles qui rendent un 500). Un
# refus metier - fauteuil occupe, numero invalide - nomme parfois un client :
# il reste ici. L adresse est nettoyee avant l envoi, et le jeton de suivi
# d un client n en sort JAMAIS.
#
# Aucun paquet a installer : l application parle a Sentry en HTTP ordinaire.
# Sentry envoie ensuite les courriels selon ses propres regles d alerte.
# SENTRY_DSN=https://xxxxxxxx@o000000.ingest.de.sentry.io/0000000

# --- Reglages divers --------------------------------------------------
# DATA_DIR=./data
# LOG_LEVEL=info

# --- Avis pousses vers le personnel -----------------------------------
# Facultatif. Sans ces cles, les avis sont eteints : rien d autre ne
# change dans le salon.
#
# Le coiffeur active les avis appareil par appareil, depuis l ecran de la
# file. Son telephone vibre alors quand un client prend son tour ou
# l annule -- l annulation etant celle qui rapporte le plus, puisque
# personne ne la voit passer autrement.
#
# Les generer : npm run avisos:cles
#
# NE LES REGENEREZ PAS une fois le salon en service. Chaque navigateur
# scelle la cle PUBLIQUE dans son abonnement : en changer rend muets,
# d un coup et sans un mot, tous les appareils deja abonnes.
#
# Aucun paquet a installer : le protocole (RFC 8291) est ecrit a la main.
# Le contenu du message est chiffre de bout en bout entre ce serveur et le
# navigateur du coiffeur. Google, Apple et Mozilla ne relaient qu un
# paquet opaque : ils voient l heure et la taille, jamais le nom d un
# client.
#
# WEBPUSH_CLE_PUBLIQUE=
# WEBPUSH_CLE_PRIVEE=
# WEBPUSH_SUJET=mailto:votre.adresse@example.com

# --- Plusieurs noms pour le meme salon --------------------------------
# Facultatif. Par defaut, le serveur ne repond que sur DOMAINE.
#
# A QUOI CA SERT. Changer d adresse sans rien casser. Le nouveau nom
# sert, l ancien continue de repondre, et le QR Code deja colle en
# vitrine reste valable le temps qu on le remplace.
#
# Le cas n est pas theorique : certains operateurs mobiles filtrent les
# domaines dynamiques (duckdns.org en tete, parce qu ils servent aussi a
# heberger des logiciels malveillants). Le site marche alors en wifi et
# pas en 4G -- c est-a-dire pas pour le client debout devant la vitrine.
#
# Caddy demande un certificat pour chaque nom, tout seul.
#
# DOMAINE reste l adresse CANONIQUE : c est elle qu encode le QR Code et
# que portent les liens de suivi. Les autres ne font que repondre aussi.
#
# Les deux vont ENSEMBLE. Sans ALLOWED_ORIGINS, le second nom affiche les
# pages mais refuse le moindre formulaire : la protection anti-CSRF ne
# reconnait pas son origine.
#
# DOMAINES=ancien.duckdns.org, nouveau.dedyn.io
# ALLOWED_ORIGINS=https://ancien.duckdns.org,https://nouveau.dedyn.io

# --- Docker (docker-compose.oci.yml) ----------------------------------
# Mot de passe du conteneur PostgreSQL. Exige par le compose : sans lui,
# « docker compose up » s arrete sur « POSTGRES_PASSWORD requis ».
# Long et tire au sort :  openssl rand -hex 24
POSTGRES_PASSWORD=
#
# SUR OCI, LE COMPOSE FIGE : NODE_ENV, PORT, HOST, DATABASE_URL, DATABASE_SSL,
# TRUST_PROXY, TRUST_PROXY_HOPS, SECURE_COOKIES, ENABLE_HSTS et PHOTOS_DIR.
# Les changer ici n a AUCUN effet en production : c est voulu.

# --- Reglages fins (vides = defauts) ----------------------------------
# Tous relayes par docker-compose.oci.yml : les poser ici suffit.
# Rotation de la cle de chiffrement : l ANCIENNE cle, le temps de la bascule.
# APP_ENCRYPTION_KEY_PREVIOUS=
# Photos de la galerie, poids maximal d un envoi (256 a 20480).
# PHOTO_MAX_KO=8192
# Corps de requete JSON maximal.
# BODY_LIMIT_KB=256
# Sessions du personnel.
# SESSION_IDLE_MINUTES=720
# SESSION_ABSOLUTE_HOURS=24
# PASSWORD_MIN_LENGTH=12
# Verrouillage apres echecs de connexion.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_RATE_MAX=10
# Debit general par adresse (par /64 en IPv6).
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX=600
# Base de donnees.
# DATABASE_STATEMENT_TIMEOUT_MS=
# DATABASE_LOCK_TIMEOUT_MS=
